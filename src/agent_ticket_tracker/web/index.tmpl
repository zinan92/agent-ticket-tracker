<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="description" content="Agent Ticket Tracker local read-only delivery observer">
<title>Agent Ticket Tracker</title>
<style>
:root{color-scheme:light dark;--bg:#edf2ee;--surface:#fbfdfc;--alt:#e5ece7;--ink:#1d2923;--muted:#68766e;--line:#d2ded6;--strong:#b5c7ba;--green:#16794c;--green-soft:#dcefe4;--amber:#b77820;--amber-soft:#f7ead3;--red:#b44c4c;--red-soft:#f6dddd;--gray:#77847d;--ring:#d8e3dc;--focus:#245f43;--shadow:0 18px 50px rgba(34,61,45,.09)}
@media(prefers-color-scheme:dark){:root{--bg:#141b17;--surface:#1c2520;--alt:#29372f;--ink:#edf4ef;--muted:#9cac9f;--line:#35453b;--strong:#4e6756;--green:#68c993;--green-soft:#193d2b;--amber:#e2ab58;--amber-soft:#47371f;--red:#ed8a8a;--red-soft:#482727;--gray:#a5b1aa;--ring:#3a4b40;--focus:#91dcb2;--shadow:0 18px 50px rgba(0,0,0,.23)}}
*{box-sizing:border-box}html{min-width:320px;background:var(--bg)}body{min-width:320px;min-height:100dvh;margin:0;background:var(--bg);color:var(--ink);font:14px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}button{font:inherit}button:focus-visible{outline:3px solid var(--focus);outline-offset:3px}.shell{width:min(1500px,100%);margin:auto;padding:24px 26px 70px}.topbar,.run-head,.pane-head,.detail-head,.summary-label{display:flex;align-items:center;justify-content:space-between;gap:16px}.topbar{margin-bottom:28px}.brand{display:flex;align-items:center;gap:12px}.brand-mark{display:grid;width:38px;height:38px;place-items:center;border:1px solid var(--strong);border-radius:10px;background:var(--surface);color:var(--green);font:800 11px ui-monospace,SFMono-Regular,Menlo,monospace;box-shadow:var(--shadow)}.eyebrow{margin:0 0 4px;color:var(--muted);font:10px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.1em;text-transform:uppercase}.brand-name{margin:0;font-weight:750;letter-spacing:-.02em}.sample{padding:8px 11px;border:1px solid color-mix(in srgb,var(--amber) 45%,var(--line));border-radius:8px;background:var(--amber-soft);color:var(--amber);font:11px ui-monospace,SFMono-Regular,Menlo,monospace}.run-head{align-items:end;margin-bottom:18px}.run-title{margin:0;font-size:clamp(28px,4vw,48px);line-height:1;letter-spacing:-.055em}.run-copy{max-width:690px;margin:10px 0 0;color:var(--muted);font-size:14px}.run-meta{color:var(--muted);font:10px/1.6 ui-monospace,SFMono-Regular,Menlo,monospace;text-align:right}.source{display:flex;align-items:start;gap:10px;margin-bottom:16px;padding:12px 14px;border:1px solid var(--line);border-radius:10px;background:var(--surface);color:var(--muted);font-size:12px}.source.live{border-color:color-mix(in srgb,var(--green) 45%,var(--line))}.source.sample{border-color:color-mix(in srgb,var(--amber) 45%,var(--line))}.source.error{border-color:color-mix(in srgb,var(--red) 55%,var(--line));background:var(--red-soft)}.source strong{color:var(--ink)}.source-error{margin:5px 0 0;color:var(--red)}.summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px;margin-bottom:17px}.summary-card{min-height:77px;padding:13px 14px;border:1px solid var(--line);border-radius:11px;background:var(--surface)}.summary-label{color:var(--muted);font-size:11px}.summary-value{display:block;margin-top:8px;font-size:21px;font-weight:760;letter-spacing:-.045em}.summary-value small{margin-left:5px;color:var(--muted);font-size:10px;font-weight:500;letter-spacing:0}.dot{display:inline-block;width:9px;height:9px;flex:0 0 auto;border-radius:50%;background:var(--gray);box-shadow:0 0 0 3px color-mix(in srgb,var(--gray) 15%,transparent)}.dot.verified{background:var(--green);box-shadow:0 0 0 3px color-mix(in srgb,var(--green) 16%,transparent)}.dot.running,.dot.partial{background:var(--amber);box-shadow:0 0 0 3px color-mix(in srgb,var(--amber) 16%,transparent)}.dot.needs-review{background:var(--red);box-shadow:0 0 0 3px color-mix(in srgb,var(--red) 16%,transparent)}.workspace{display:grid;grid-template-columns:220px minmax(0,1fr) 340px;min-height:650px;overflow:hidden;border:1px solid var(--line);border-radius:15px;background:var(--surface);box-shadow:var(--shadow)}.rail,.map,.detail{min-width:0}.rail{padding:19px 14px;border-right:1px solid var(--line);background:color-mix(in srgb,var(--alt) 43%,var(--surface))}.rail-title{display:flex;justify-content:space-between;margin:0 7px 14px;color:var(--muted);font:10px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.08em;text-transform:uppercase}.rail-list{display:grid;gap:5px}.rail-item{display:flex;align-items:center;gap:8px;width:100%;padding:9px;border:1px solid transparent;border-radius:8px;background:transparent;color:var(--muted);cursor:pointer;font-size:12px;text-align:left}.rail-item:hover,.rail-item.selected{border-color:var(--line);background:var(--surface);color:var(--ink)}.rail-item.selected{box-shadow:inset 3px 0 0 var(--green)}.rail-count{margin-left:auto;color:var(--muted);font:10px ui-monospace,SFMono-Regular,Menlo,monospace}.rail-note{margin:26px 7px 0;padding-top:15px;border-top:1px solid var(--line);color:var(--muted);font-size:11px}.map{padding:22px 24px 28px;overflow:auto}.pane-head{align-items:start;margin-bottom:18px}.pane-title{margin:0;font-size:16px;letter-spacing:-.025em}.pane-sub{margin:4px 0 0;color:var(--muted);font-size:12px}.legend{display:flex;flex-wrap:wrap;justify-content:end;gap:10px;color:var(--muted);font-size:10px}.legend span{display:inline-flex;align-items:center;gap:6px}.tree{display:grid;gap:10px;min-width:560px;padding:18px;border:1px solid var(--line);border-radius:12px;background:color-mix(in srgb,var(--alt) 30%,var(--surface))}.tree-children{display:grid;gap:7px;margin:6px 0 0 12px;padding-left:14px;border-left:1px solid var(--strong)}.tree-node{display:grid;grid-template-columns:20px minmax(0,1fr) auto;align-items:center;gap:8px;width:100%;min-height:42px;padding:8px 10px;border:1px solid transparent;border-radius:8px;background:transparent;color:var(--ink);cursor:pointer;text-align:left}.tree-node:hover,.tree-node.selected{border-color:var(--strong);background:var(--surface);box-shadow:var(--shadow)}.tree-node.root{min-height:53px;border-color:var(--line);background:var(--surface)}.tree-node.phase{background:color-mix(in srgb,var(--alt) 35%,transparent)}.node-name{display:block;overflow:hidden;font-size:12px;font-weight:680;text-overflow:ellipsis;white-space:nowrap}.tree-node.root .node-name{font-size:14px}.node-kind{display:block;margin-top:2px;overflow:hidden;color:var(--muted);font:10px ui-monospace,SFMono-Regular,Menlo,monospace;text-overflow:ellipsis;white-space:nowrap}.node-progress{color:var(--muted);font:10px ui-monospace,SFMono-Regular,Menlo,monospace;white-space:nowrap}.ring{position:relative;display:inline-grid;width:17px;height:17px;place-items:center;border-radius:50%;background:conic-gradient(var(--ring-color,var(--gray)) calc(var(--progress,0)*1%),var(--ring) 0)}.ring:after{width:9px;height:9px;border-radius:50%;background:var(--surface);content:""}.tree-node.root .ring{width:22px;height:22px}.tree-node.root .ring:after{width:12px;height:12px}.map-foot{display:flex;justify-content:space-between;gap:12px;margin-top:13px;padding:11px 13px;border:1px dashed var(--strong);border-radius:9px;color:var(--muted);font-size:11px}.map-foot strong{color:var(--ink)}.detail{padding:21px 19px 26px;border-left:1px solid var(--line);background:color-mix(in srgb,var(--alt) 31%,var(--surface))}.detail.closed{display:grid;place-items:center;align-content:center;padding:25px;text-align:center}.detail-head{align-items:start}.detail-title{margin:0;font-size:20px;letter-spacing:-.045em}.detail-status{display:flex;align-items:center;gap:8px;margin:7px 0 0;color:var(--muted);font-size:12px}.detail-status span{color:var(--muted);font:10px ui-monospace,SFMono-Regular,Menlo,monospace}.close{display:grid;width:28px;height:28px;place-items:center;border:1px solid var(--line);border-radius:7px;background:var(--surface);color:var(--muted);cursor:pointer;font-size:17px;line-height:1}.close:hover{border-color:var(--red);color:var(--red)}.detail-progress{display:flex;align-items:center;gap:10px;margin:19px 0;padding:12px;border:1px solid var(--line);border-radius:9px;background:var(--surface)}.detail-progress .ring{width:34px;height:34px}.detail-progress .ring:after{width:20px;height:20px}.detail-progress strong{display:block;font-size:16px}.detail-progress small{display:block;margin-top:2px;color:var(--muted);font-size:10px}.detail-section{padding:15px 0;border-top:1px solid var(--line)}.detail-section h4{margin:0 0 9px;color:var(--muted);font:10px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.08em;text-transform:uppercase}.check-list,.evidence-list{display:grid;gap:8px;margin:0;padding:0;list-style:none}.check-list li,.evidence-list li{display:grid;grid-template-columns:18px minmax(0,1fr);gap:7px;color:var(--muted);font-size:11px}.check-mark{color:var(--green);font-weight:800}.check-mark.pending{color:var(--muted)}.evidence-kind{display:block;color:var(--ink);font-weight:650}.evidence-meta{display:block;margin-top:2px;color:var(--muted);font:9px ui-monospace,SFMono-Regular,Menlo,monospace;overflow-wrap:anywhere}.next-action{margin:0;color:var(--ink);font-size:12px;font-weight:680}.next-note{margin:5px 0 0;color:var(--muted);font-size:10px}.detail-button{width:100%;margin-top:14px;padding:9px 11px;border:1px solid var(--strong);border-radius:8px;background:var(--surface);color:var(--muted);cursor:default;font-size:11px}.empty{max-width:215px;color:var(--muted);font-size:12px}@media(max-width:1050px){.workspace{grid-template-columns:185px minmax(0,1fr) 300px}.app-shell{padding:20px 16px 70px}}@media(max-width:840px){.summary{grid-template-columns:repeat(2,minmax(0,1fr))}.workspace{display:block;min-height:0;overflow:visible}.rail{border-right:0;border-bottom:1px solid var(--line)}.rail-list{grid-template-columns:repeat(5,minmax(95px,1fr))}.rail-note{display:none}.detail{border-top:1px solid var(--line);border-left:0}.tree{min-width:0}}@media(max-width:560px){.topbar,.run-head{align-items:start;flex-direction:column}.topbar{gap:13px}.run-meta{text-align:left}.run-copy{font-size:13px}.rail-list{grid-template-columns:repeat(2,minmax(0,1fr))}.map,.detail{padding:18px 13px 22px}.tree{padding:10px}.map-foot{display:block}.map-foot span{display:block;margin-top:4px}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;transition-duration:.01ms!important;animation-duration:.01ms!important;animation-iteration-count:1!important}}
</style>
<style>
.observations{margin-top:17px;padding:17px 19px;border:1px solid var(--line);border-radius:12px;background:var(--surface);box-shadow:var(--shadow)}
.observation-head{display:flex;align-items:start;justify-content:space-between;gap:16px;margin-bottom:12px}
.observation-title{margin:0;font-size:15px;letter-spacing:-.025em}
.observation-copy{margin:4px 0 0;color:var(--muted);font-size:11px}
.observation-meta{color:var(--muted);font:10px ui-monospace,SFMono-Regular,Menlo,monospace}
.observation-list{display:grid;gap:7px}
.observation-item{display:grid;grid-template-columns:72px minmax(0,1fr) minmax(145px,auto);align-items:center;gap:11px;padding:10px 11px;border:1px solid var(--line);border-radius:8px;background:color-mix(in srgb,var(--alt) 25%,var(--surface))}
.observation-item strong{display:block;color:var(--ink);font-size:11px}
.observation-item p{margin:3px 0 0;color:var(--muted);font:10px/1.45 ui-monospace,SFMono-Regular,Menlo,monospace;overflow-wrap:anywhere}
.observation-item time{color:var(--muted);font:9px ui-monospace,SFMono-Regular,Menlo,monospace;text-align:right}
.observation-status{display:inline-flex;justify-content:center;padding:4px 6px;border-radius:5px;font:9px ui-monospace,SFMono-Regular,Menlo,monospace}
.observation-status.observed{background:var(--green-soft);color:var(--green)}
.observation-status.unavailable{background:var(--amber-soft);color:var(--amber)}
.observation-status.error{background:var(--red-soft);color:var(--red)}
@media(max-width:560px){.observations{padding:15px 13px}.observation-item{grid-template-columns:1fr;gap:5px}.observation-item time{text-align:left}}
</style>
</head>
<body>
<div id="app"></div>
<script>
const app=document.getElementById("app");let state=null,selectedId=null,loading=true;
const stateUrl="/api/state";
function observationFeed(){const items=state?.observations||[];const names={observed:"已读到",unavailable:"不可用",error:"读取失败"};const rows=items.length?items.map(item=>"<article class=\"observation-item\"><span class=\"observation-status "+(names[item.status]?item.status:"error")+"\">"+esc(names[item.status]||"未知")+"</span><div><strong>"+esc(item.label)+"</strong><p>"+esc(item.detail)+"</p></div><time>"+esc(item.observedAt)+"</time></article>").join(""):"<p class=\"observation-copy\">暂无观察信号。</p>";return "<section class=\"observations\" aria-label=\"最近观察\"><div class=\"observation-head\"><div><h2 class=\"observation-title\">最近观察</h2><p class=\"observation-copy\">只读提取过程信号，不改变任何开发状态。</p></div><span class=\"observation-meta\">"+items.length+" signals</span></div><div class=\"observation-list\">"+rows+"</div></section>"}
const statusNames={verified:"已验证",running:"运行中",partial:"部分完成","needs-review":"需审查",blocked:"已阻塞",waiting:"等待中",ready:"可开始",planned:"已计划"};
const esc=v=>String(v??"").replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;").replaceAll('"',"&quot;").replaceAll("'","&#39;");
const label=s=>statusNames[s]||"未知状态";
const klass=s=>Object.hasOwn(statusNames,s)?s:"waiting";
const node=id=>state?.nodes?.find(item=>item.id===id)||null;
const ring=n=>{const p=n.progress||{done:0,total:1},pct=p.total?Math.round(p.done/p.total*100):0;const tone=n.status==="verified"?"green":n.status==="needs-review"?"red":n.status==="running"||n.status==="partial"?"amber":"gray";return `<span class="ring" style="--progress:${pct};--ring-color:var(--${tone})" aria-label="${p.done} / ${p.total}"></span>`};
const dot=s=>`<span class="dot ${klass(s)}" aria-label="${esc(label(s))}"></span>`;
function tree(id,depth=0){const n=node(id);if(!n)return"";const selected=id===selectedId?"selected":"",children=n.children?.length?`<div class="tree-children">${n.children.map(child=>tree(child,depth+1)).join("")}</div>`:"";return `<div><button class="tree-node ${depth===0?"root":n.children?.length?"phase":"leaf"} ${selected}" data-node="${esc(id)}" aria-label="查看 ${esc(n.name)}，${esc(label(n.status))}">${ring(n)}<span><span class="node-name">${esc(n.name)}</span><span class="node-kind">${esc(n.kind)} · ${esc(label(n.status))}</span></span><span class="node-progress">${n.progress.done} / ${n.progress.total}</span></button>${children}</div>`}
function rail(){return `<aside class="rail"><p class="rail-title"><span>Delivery map</span><span>${esc(state.source.status)}</span></p><div class="rail-list">${["run","spec","tickets","implementation","release"].map(id=>{const n=node(id);return n?`<button class="rail-item ${id===selectedId?"selected":""}" data-node="${esc(id)}">${dot(n.status)}<span>${esc(n.name)}</span><span class="rail-count">${n.progress.done}/${n.progress.total}</span></button>`:""}).join("")}</div><p class="rail-note">地图负责全貌，详情负责证据和下一步。</p></aside>`}
function detail(){if(!selectedId||!node(selectedId))return `<aside class="detail closed"><strong>详情暂时关闭</strong><p class="empty">点击地图中的任意节点，打开不改变地图位置的检查层。</p></aside>`;const n=node(selectedId),checks=n.acceptance||[],evidence=n.evidence||[],blockers=(n.blockerIds||[]).map(node).filter(Boolean);return `<aside class="detail"><div class="detail-head"><div><p class="eyebrow">Selected node</p><h2 class="detail-title">${esc(n.name)}</h2><p class="detail-status">${dot(n.status)} ${esc(label(n.status))}<span>${esc(n.kind)}</span></p></div><button class="close" data-close aria-label="关闭详情">×</button></div><div class="detail-progress">${ring(n)}<div><strong>${n.progress.done} / ${n.progress.total}</strong><small>当前完成比例</small></div></div><section class="detail-section"><h4>Acceptance</h4><ul class="check-list">${checks.length?checks.map(item=>`<li><span class="check-mark ${item.status==="verified"?"":"pending"}">${item.status==="verified"?"✓":"○"}</span><span>${esc(item.label)}</span></li>`).join(""):"<li><span class=\"check-mark pending\">○</span><span>暂无结构化验收项</span></li>"}</ul></section><section class="detail-section"><h4>Evidence</h4><ul class="evidence-list">${evidence.length?evidence.map(item=>`<li>${dot(item.status==="verified"?"verified":"needs-review")}<span><span class="evidence-kind">${esc(item.label)}</span><span class="evidence-meta">${esc(item.kind)} · ${esc(item.status)} · ${esc(item.ref)}</span></span></li>`).join(""):"<li>暂无证据。节点不能因此变绿。</li>"}</ul></section>${blockers.length?`<section class="detail-section"><h4>Blocked by</h4><ul class="evidence-list">${blockers.map(item=>`<li>${dot(item.status)}<span>${esc(item.name)}<span class="evidence-meta">${esc(label(item.status))}</span></span></li>`).join("")}</ul></section>`:""}<section class="detail-section"><h4>Next action</h4><p class="next-action">${esc(n.nextAction)}</p><p class="next-note">${esc(n.note)}</p><button class="detail-button" aria-disabled="true">MVP 只读模式</button></section></aside>`}
function sourceBanner(){const s=state.source,t=s.status==="live"?"live":s.status==="sample"?"sample":"error",isAskPark=s.kind==="ask_park",isArtifacts=s.kind==="project_artifacts",title=s.status==="live"?(isAskPark?"ASK PARK LIVE":isArtifacts?"PROJECT READ":"LIVE READ"):s.status==="sample"?"SAMPLE DATA":`SOURCE ${String(s.status).toUpperCase()}`,message=s.status==="live"?(isAskPark?"数据来自 .ask-park/state.json 的只读投影。":isArtifacts?"未发现结构化 workflow source；当前只展示真实项目 artifact/Git 观察，不产生 frontier。":"数据来自当前项目声明的本地来源，页面会在下一次读取时刷新。"):s.status==="sample"?"这是演示数据，不产生可执行 frontier。":"来源不可安全使用，当前不产生可执行 frontier。";return `<div class="source ${t}">${dot(s.status==="live"&&isArtifacts?"partial":s.status==="live"?"verified":s.status==="sample"?"partial":"needs-review")}<div><strong>${title}</strong> ${message}${s.errors?.length?`<p class="source-error">${s.errors.map(esc).join("; ")}</p>`:""}</div></div>`}
function render(){if(!state){app.innerHTML=`<main class="shell"><div class="source error">${dot("needs-review")}<div><strong>正在读取项目状态</strong><p class="source-error">${loading?"等待本地控制器响应":"无法读取状态"}</p></div></div></main>`;return}const sum=state.summary||{verified:0,total:0,active:0,needsReview:0};const selected=node(selectedId)||node("run")||state.nodes?.[0];if(!selectedId&&selected)selectedId=selected.id;app.innerHTML=`<main class="shell"><header class="topbar"><div class="brand"><span class="brand-mark">ATT</span><div><p class="eyebrow">Agent delivery control plane</p><p class="brand-name">Agent Ticket Tracker</p></div></div><span class="sample">MVP · local only</span></header><section class="run-head"><div><p class="eyebrow">Delivery run</p><h1 class="run-title">${esc(state.run.displayName)}</h1><p class="run-copy">把 Spec、Tickets、Implementation 和 Release 放进一张可检查的全貌地图。</p></div><div class="run-meta">read-only observer<br>${esc(state.generatedAt)}</div></section>${sourceBanner()}<section class="summary" aria-label="Delivery summary"><div class="summary-card"><div class="summary-label"><span>已验证节点</span>${dot("verified")}</div><strong class="summary-value">${sum.verified}<small>/ ${sum.total}</small></strong></div><div class="summary-card"><div class="summary-label"><span>活动节点</span>${dot("running")}</div><strong class="summary-value">${sum.active}<small>active</small></strong></div><div class="summary-card"><div class="summary-label"><span>需要审查</span>${dot("needs-review")}</div><strong class="summary-value">${sum.needsReview}<small>open</small></strong></div><div class="summary-card"><div class="summary-label"><span>当前选择</span>${dot(selected?.status||"waiting")}</div><strong class="summary-value" style="font-size:15px">${esc(selected?.name||"无节点")}</strong></div></section><section class="workspace">${rail()}<main class="map"><div class="pane-head"><div><h2 class="pane-title">全貌地图</h2><p class="pane-sub">点击节点查看详情，地图位置保持不变。</p></div><div class="legend"><span>${dot("verified")} 已验证</span><span>${dot("running")} 进行中</span><span>${dot("needs-review")} 需审查</span></div></div><div class="tree">${tree("run")||"<p>当前没有可显示的节点。</p>"}</div><div class="map-foot"><span><strong>Frontier</strong> ${state.frontier.length?`${state.frontier.length} 个节点可检查`:"当前没有可执行节点"}</span><span>每 2 秒重新读取</span></div></main>${detail()}</section></main>`;bind()}
function bind(){const shell=document.querySelector("main.shell"),brand=document.querySelector(".brand .eyebrow");if(brand)brand.textContent="Agent delivery observer";if(shell&&!shell.querySelector(".observations"))shell.insertAdjacentHTML("beforeend",observationFeed());document.querySelectorAll("[data-node]").forEach(el=>el.addEventListener("click",()=>{selectedId=el.dataset.node;render()}));document.querySelector("[data-close]")?.addEventListener("click",()=>{selectedId=null;render()})}
async function refresh(){loading=true;try{const response=await fetch(stateUrl,{cache:"no-store"});state=await response.json();if(selectedId&&!node(selectedId))selectedId=null}catch(error){state={run:{displayName:"状态读取失败"},source:{status:"malformed",errors:[String(error)]},nodes:[],frontier:[],summary:{verified:0,total:0,active:0,needsReview:0},generatedAt:new Date().toISOString()}}finally{loading=false;render()}}
refresh();window.setInterval(refresh,2000);
</script>
</body>
</html>
